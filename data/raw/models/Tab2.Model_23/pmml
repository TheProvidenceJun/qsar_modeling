    <RegressionModel functionName="regression" targetFieldName="properties/M23.pLC50">
        <MiningSchema>
            <MiningField name="properties/M23.pLC50" usageType="predicted"/>
            <MiningField name="descriptors/VP-1" usageType="active"/>
            <MiningField name="descriptors/nHBAcc" usageType="active"/>
            <MiningField name="descriptors/minHBd" usageType="active"/>
        </MiningSchema>
        <RegressionTable intercept="3.6171">
            <NumericPredictor name="descriptors/VP-1" coefficient="0.3008"/>
            <NumericPredictor name="descriptors/nHBAcc" coefficient="-0.1695"/>
            <NumericPredictor name="descriptors/minHBd" coefficient="-1.2047"/>
        </RegressionTable>
    </RegressionModel>
</PMML>
