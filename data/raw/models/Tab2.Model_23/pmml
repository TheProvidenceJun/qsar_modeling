<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<PMML xmlns="http://www.dmg.org/PMML-4_1" version="4.1">
    <DataDictionary>
        <DataField name="properties/M23.pLC50" displayName="Acute toxicity to fish" optype="continuous" dataType="double"/>
        <DataField name="descriptors/VP-1" displayName="Valence path, order 1" optype="continuous" dataType="double"/>
        <DataField name="descriptors/nHBAcc" displayName="Number of hydrogen bond acceptors (using CDK HBondAcceptorCountDescriptor algorithm)" optype="continuous" dataType="double"/>
        <DataField name="descriptors/minHBd" displayName="The minimum E-State energy for hydrogen bond donors" optype="continuous" dataType="double"/>
